+-- Where import parked this song's pre-rendered audio, or nil when the platform
+-- synthesizes live (every platform but the 3DS) or the file was never written.
+-- Answers are cached because the existence tests here sit on the song-choice
+-- path, which runs far more often than a song actually changes.
+local prerenderCache = {}
+
+local function prerenderedFile(data, song)
+  if not require("src.core.Console").prefersPrerenderedMusic() then return nil end
+  local getInfo = love and love.filesystem and love.filesystem.getInfo
+  if not getInfo then return nil end
+  -- Same order CacheFs.readActive resolves cache files in: the active
+  -- version's prefixed tree (yellow/assets/generated/...) first, then the
+  -- plain path for a build that mounts the version at the root.  The prefix
+  -- has to come from GameVersion, not audio.programPrefix -- that field only
+  -- exists on the copy ChipAudio hands the worker, and only on NX.
+  local prefix = require("src.core.GameVersion").cachePrefix() or ""
+  -- Keyed by prefix AND song: the launcher can switch versions inside one
+  -- process, and every version names its songs the same, so a song-only key
+  -- would answer Red with the Yellow recording still sitting in the cache.
+  local key = prefix .. "\0" .. song
+  local hit = prerenderCache[key]
+  if hit ~= nil then return hit or nil end
+  local path = "assets/generated/audio/music/" .. song .. ".wav"
+  local found = false
+  if prefix ~= "" and getInfo(prefix .. path) then
+    found = prefix .. path
+  elseif getInfo(path) then
+    found = path
+  end
+  prerenderCache[key] = found
+  return found or nil
+end
+
+-- Dropped when a reimport may have changed what is on disk (ChipAudio.invalidate).
+function Music.invalidatePrerender()
+  prerenderCache = {}
+end
