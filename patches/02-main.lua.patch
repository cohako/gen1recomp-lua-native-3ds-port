 end
 
-function love.draw()
+function love.draw(screen)
+  -- 3DS: LOVE Potion calls love.draw once per SCREEN (left/right/bottom
+  -- with 3D enabled), so the whole pipeline ran three times a frame --
+  -- triple the vertex/command budget for two images nobody sees (the right
+  -- eye duplicates the left; the bottom screen has no game content yet).
+  -- Draw the top-left pass only; the runner already cleared the others.
+  if screen and screen ~= "left"
+     and require("src.core.Console").is3DS() then
+    return
+  end
   if editorMode then
     GameViewport.reset()
     HostDisplay.beginFrame("editor", EditorApp)
