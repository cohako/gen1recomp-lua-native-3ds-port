 local editorMode = os.getenv("POKEPORT_EDITOR") == "1" or POKEPORT_EDITOR_MODE == true
 
+-- 3DS quirks that live at the love.graphics surface.  (The old
+-- retain-every-canvas workaround is gone: the engine fork now defers
+-- C3D_RenderTargetDelete to end-of-frame, so canvases release normally --
+-- retaining them forever was leaking VRAM until newCanvas failed.)
+do
+  local okConsole, Console = pcall(require, "src.core.Console")
+  if okConsole and Console.is3DS()
+      and love.graphics and love.graphics.newCanvas then
+    -- The CTR build has no love.graphics.setShader at all, so even
+    -- shader-guarded call sites crash when a code path obtains a shader-like
+    -- value (battle heal flash did).  PaletteFX.shader() returns nil here,
+    -- so a no-op keeps every caller on its colorless fallback.
+    love.graphics.setShader = love.graphics.setShader or function() end
+
+    -- Freeze probe (opt-in diagnostic, off by default): once a second,
+    -- record what the game THINKS it drew.  The engine-side telemetry showed
+    -- the main loop alive and the draw count dropping during the on-device
+    -- screen freeze; this tells whether the world pass stopped running (game
+    -- logic) or ran and never showed (engine).  Pulled over FTP from the save
+    -- dir.  Does blocking SD-card I/O, so it must never run unattended on a
+    -- shipped build -- set POKEPORT_CTR_PROBE=1 to enable it for a debug run.
+    local okProbe, wantProbe = pcall(os.getenv, "POKEPORT_CTR_PROBE")
+    if okProbe and wantProbe == "1" then
+      local probeFrames = 0
+      _G.__ctrProbeAfterDraw = function(Game)
+        probeFrames = probeFrames + 1
+        if probeFrames == 1 then
+          pcall(function()
+            love.filesystem.write("probe3ds.txt", "probe start\n")
+          end)
+        end
+        if probeFrames % 60 ~= 0 then return end
+        pcall(function()
+          local audio = require("src.core.ChipAudio")
+          local state = audio.debugState and audio.debugState() or "n/a"
+          love.filesystem.append("probe3ds.txt",
+            ("f=%d audio: %s\n"):format(probeFrames, state))
+        end)
+      end
+    end
+  end
+end
+
+_G.__ctrProbeAfterDraw = _G.__ctrProbeAfterDraw or function() end
+
