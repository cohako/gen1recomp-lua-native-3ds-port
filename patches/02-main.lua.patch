 local editorMode = os.getenv("POKEPORT_EDITOR") == "1" or POKEPORT_EDITOR_MODE == true
 
+-- 3DS quirks that live at the love.graphics surface.  (The old
+-- retain-every-canvas workaround is gone: the engine fork now defers
+-- C3D_RenderTargetDelete to end-of-frame, so canvases release normally --
+-- retaining them forever was leaking VRAM until newCanvas failed.)
+do
+  local okConsole, Console = pcall(require, "src.core.Console")
+  if okConsole and Console.is3DS()
+      and love.graphics and love.graphics.newCanvas then
+    -- The CTR build has no love.graphics.setShader at all, so even
+    -- shader-guarded call sites crash when a code path obtains a shader-like
+    -- value (battle heal flash did).  PaletteFX.shader() returns nil here,
+    -- so a no-op keeps every caller on its colorless fallback.
+    love.graphics.setShader = love.graphics.setShader or function() end
+
+  end
+end
+
+_G.__ctrProbeAfterDraw = _G.__ctrProbeAfterDraw or function() end
+
 local SwitchDiagnostics = require("src.debug.SwitchDiagnostics")
 local LaunchOptions = require("src.core.LaunchOptions")
 local NxDisplay = require("src.core.NxDisplay")
